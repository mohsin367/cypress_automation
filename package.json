{
  "devDependencies": {
    "cypress": "^15.7.1",
    "cypress-xpath": "^2.0.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "scripts": {
  "cy:run": "cypress run",
  "report:merge": "npx mochawesome-merge cypress/reports/*.json -o cypress/reports/merged.json",
  "report:generate": "npx marge cypress/reports/merged.json -f index -o cypress/reports/html"
}

}
